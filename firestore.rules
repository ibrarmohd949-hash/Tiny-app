rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50 &&
             data.email is string && data.email.size() <= 100 &&
             (data.get('photoURL', '') is string) &&
             (data.get('bio', '') is string) &&
             data.createdAt == request.time;
    }

    function isValidVideo(data) {
      return data.userId == request.auth.uid &&
             data.videoURL is string && data.videoURL.size() < 1000 &&
             data.createdAt == request.time &&
             data.likesCount == 0 &&
             data.commentsCount == 0;
    }

    // --- Match Rules ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                       incoming().isAdmin == false && incoming().isVerified == false &&
                       incoming().coins == 50 && incoming().creatorEarnings == 0;
      
      allow update: if isOwner(userId) && 
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoURL', 'bio', 'updatedAt', 
                         'coins', 'creatorEarnings', 'verificationStatus'
                       ]) &&
                       incoming().updatedAt == request.time;
                       
      allow update: if isSignedIn() && 
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'followersCount', 'followingCount', 'totalLikes'
                       ]); 
                       
      allow update, delete: if isAdmin();
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true; // Public feed
      allow create: if isSignedIn() && isValidVideo(incoming());
      allow update: if (isOwner(existing().userId) && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'title', 'hashtags', 'aiGenerated']) &&
                        isValidVideo(incoming())) ||
                       isAdmin();
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'shareCount', 'viewCount']); // Public interactions
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Likes (relational subcollection)
    match /videos/{videoId}/likes/{userId} {
      allow read: if true;
      allow create, delete: if isOwner(userId);
    }

    // Comments
    match /videos/{videoId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().text.size() <= 1000;
      allow delete: if isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/videos/$(videoId)).data.userId) || isAdmin();
    }

    // Social Graph
    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow create, delete: if isOwner(followerId);
    }

    match /users/{userId}/following/{followingId} {
      allow read: if true;
      allow create, delete: if isOwner(userId);
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && request.auth.uid in incoming().participants;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid && 
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn(); // Other users can trigger notifications
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}
