{
  "version": 2,
  "framework": "vite",
  "build": {
    "env": {
      "NODE_VERSION": "20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "dist"
}
